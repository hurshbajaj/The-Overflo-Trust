generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CONSUMER
  STEWARD
}

enum FreshnessLevel {
  PRIME
  FRESH
  STANDARD
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         Role
  createdAt    DateTime  @default(now())
  sessions     Session[]
  ratings      Rating[]
  comments     Comment[]
  profile      StewardProfile?
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StewardProfile {
  id                 String              @id @default(cuid())
  userId             String              @unique
  slug               String              @unique
  brandName          String
  category           String
  story              String
  description        String
  address            String
  city               String
  latitude           Float?
  longitude          Float?
  contactEmail       String?
  contactPhone       String?
  openHours          String?
  republicScore      Float               @default(0)
  consistencyStreak  Int                 @default(0)
  successfulPickups  Int                 @default(0)
  failedPickups      Int                 @default(0)
  averageRating      Float               @default(0)
  profileViews       Int                 @default(0)
  totalMealsDonated  Int                 @default(0)
  badge              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItems          MenuItem[]
  photos             Photo[]
  ratings            Rating[]
  comments           Comment[]
  donations          DonationEntry[]
  leaderboardStats   LeaderboardStat[]
  luckyStats         LuckyExposureStat[]
}

model MenuItem {
  id        String         @id @default(cuid())
  profileId String
  title     String
  details   String
  createdAt DateTime       @default(now())
  profile   StewardProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Photo {
  id        String         @id @default(cuid())
  profileId String
  imageUrl  String
  caption   String?
  createdAt DateTime       @default(now())
  profile   StewardProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Rating {
  id        String         @id @default(cuid())
  profileId String
  userId    String
  score     Int
  createdAt DateTime       @default(now())
  profile   StewardProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String         @id @default(cuid())
  profileId String
  userId    String
  body      String
  createdAt DateTime       @default(now())
  profile   StewardProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DonationEntry {
  id                 String         @id @default(cuid())
  profileId          String
  title              String
  quantityMeals      Int
  description        String
  pickupWindow       String
  freshness          FreshnessLevel
  imageUrl           String?
  proofSource        String?
  pickupSuccess      Boolean
  responseMinutes    Int
  createdAt          DateTime       @default(now())
  profile            StewardProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model LeaderboardStat {
  id               String         @id @default(cuid())
  profileId        String
  rank             Int
  score            Float
  scoreDelta       Float
  viewsDelta       Int
  periodLabel      String
  createdAt        DateTime       @default(now())
  profile          StewardProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model LuckyExposureStat {
  id                String         @id @default(cuid())
  profileId         String         @unique
  luckyAppearances  Int            @default(0)
  clickThroughs     Int            @default(0)
  ratingGrowth      Float          @default(0)
  popularityGained  Float          @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  profile           StewardProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}
